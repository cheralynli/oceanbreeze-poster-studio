{
  "name": "oceanbreeze-poster-generator",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w server\" \"npm run dev -w client\"",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "start": "npm run start -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
